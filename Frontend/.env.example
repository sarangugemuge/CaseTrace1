# CASETRACE Environment Variable Template (Phase 6)

# Frontend Data Source Mode
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_MODE=real

# Backend PostgreSQL Database Configuration
