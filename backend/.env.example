# CASETRACE Backend Environment Variable Template
PROJECT_NAME=CASETRACE API
VERSION=1.0.0
API_PREFIX=/api

# PostgreSQL Connection String (Fallback: sqlite:///./casetrace.db)
DATABASE_URL=postgresql://casetrace_user:casetrace_pass@localhost:5432/casetrace_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

JWT_SECRET=casetrace_secure_jwt_secret_key_2026_demo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
