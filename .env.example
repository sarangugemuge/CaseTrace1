# CASETRACE Environment Variable Template (Phase 5)

# Frontend Mode & API Settings
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_MODE=real

# Backend PostgreSQL Database Configuration
# Safe local default: sqlite:///./casetrace.db
# PostgreSQL Example: postgresql://casetrace_user:casetrace_pass@localhost:5432/casetrace_db
DATABASE_URL=postgresql://casetrace_user:casetrace_pass@localhost:5432/casetrace_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Backend Security
JWT_SECRET=casetrace_secure_jwt_secret_key_2026_demo
ALGORITHM=HS256
